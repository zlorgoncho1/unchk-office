<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- Parent : POM agrégateur du monorepo (fournit Spring Boot 3.3.4 + Spring Cloud 2023.0.3) -->
  <parent>
    <groupId>sn.unchk.office</groupId>
    <artifactId>unchk-office-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>insertion-service</artifactId>
  <name>UNCHK Office — Insertion Service</name>
  <description>Appui à l'insertion : suivi des étudiants (registre de contact, bilans de stages),
    statistiques d'insertion (auto-emploi vs emploi salarié) et base de partenaires.
    Émet le topic insertion.events ; projette people.students et academic.formations en local.</description>

  <dependencies>
    <!-- Librairie transverse maison : sécurité JWT/JWKS, autorisation OPA anti-IDOR,
         gestion d'erreurs web, configuration Kafka (producteur/consommateur), export, audit. -->
    <dependency>
      <groupId>sn.unchk.office</groupId>
      <artifactId>common</artifactId>
      <version>0.1.0-SNAPSHOT</version>
    </dependency>

    <!-- Web MVC (servlet, PAS réactif) : contrôleurs REST. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <!-- Persistance relationnelle PostgreSQL via Spring Data JPA. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>

    <!-- Validation des DTO (Jakarta Bean Validation). -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <!-- Supervision (santé / info) pour les sondes Docker. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>

    <!-- Messagerie : SEUL canal de communication inter-services (Kafka KRaft). -->
    <dependency>
      <groupId>org.springframework.kafka</groupId>
      <artifactId>spring-kafka</artifactId>
    </dependency>

    <!-- Client de configuration centralisée (Spring Cloud Config) : permet l'import
         OPTIONNEL depuis le Config Server. Le service démarre même si le serveur est absent
         (préfixe optional: dans spring.config.import). -->
    <dependency>
      <groupId>org.springframework.cloud</groupId>
      <artifactId>spring-cloud-starter-config</artifactId>
    </dependency>

    <!-- Pilote PostgreSQL. -->
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- Migrations de schéma Flyway (PostgreSQL). -->
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>

    <!-- Tests : JUnit 5, Mockito, assertions Spring. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Tests : utilitaires de sécurité Spring (jetons JWT simulés, etc.). -->
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Tests : utilitaires Spring Kafka (broker embarqué éventuel). -->
    <dependency>
      <groupId>org.springframework.kafka</groupId>
      <artifactId>spring-kafka-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- Produit un jar exécutable (application Spring Boot). -->
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>

</project>
