# ============================================================
# UNCHK Office — variables d'environnement (exemple)
# Copier en `.env` puis adapter. Le fichier `.env` est ignoré par git.
# ============================================================

# --- PostgreSQL ---
POSTGRES_USER=unchk
POSTGRES_PASSWORD=unchk_dev_pwd
POSTGRES_DB=unchk

# --- MinIO (stockage objet S3) ---
MINIO_ROOT_USER=unchk
MINIO_ROOT_PASSWORD=unchk_dev_pwd

# --- Kafka (KRaft natif, sans ZooKeeper) ---
KAFKA_BOOTSTRAP_INTERNAL=kafka:19092
KAFKA_BOOTSTRAP_EXTERNAL=localhost:9092

# --- OPA ---
OPA_URL=http://opa:8181

# --- JWT / Identity (clés générées par identity-service au démarrage) ---
JWT_ISSUER=unchk-office
JWT_ACCESS_TTL_MIN=30
JWT_REFRESH_TTL_DAYS=7
