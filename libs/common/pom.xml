<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- Parent : POM agrégateur du monorepo (fournit Spring Boot 3.3.4 + Spring Cloud 2023.0.3) -->
  <parent>
    <groupId>sn.unchk.office</groupId>
    <artifactId>unchk-office-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>common</artifactId>
  <name>UNCHK Office — Common</name>
  <description>Librairie transverse (servlet/Spring MVC) des microservices métier :
    sécurité JWT/JWKS, autorisation OPA anti-IDOR, gestion d'erreurs, messagerie Kafka,
    export PDF/Excel et journalisation d'audit. NON destinée au gateway réactif (WebFlux).</description>

  <!-- Versions des dépendances non gérées par le BOM Spring Boot -->
  <properties>
    <poi.version>5.3.0</poi.version>
    <openpdf.version>1.3.30</openpdf.version>
  </properties>

  <dependencies>
    <!-- Web MVC (servlet) : socle commun des services métier -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <!-- Sécurité Spring + serveur de ressources OAuth2 (validation des JWT via JWKS) -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
    </dependency>

    <!-- Validation des DTO (Jakarta Bean Validation) -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <!-- Programmation orientée aspect : garde d'accès objet (@VerifieAccesObjet) -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-aop</artifactId>
    </dependency>

    <!-- Messagerie : producteurs/consommateurs Kafka (sérialisation JSON) -->
    <dependency>
      <groupId>org.springframework.kafka</groupId>
      <artifactId>spring-kafka</artifactId>
    </dependency>

    <!-- Export Excel (Apache POI, format xlsx) -->
    <dependency>
      <groupId>org.apache.poi</groupId>
      <artifactId>poi-ooxml</artifactId>
      <version>${poi.version}</version>
    </dependency>

    <!-- Export PDF (OpenPDF, fork libre d'iText) -->
    <dependency>
      <groupId>com.github.librepdf</groupId>
      <artifactId>openpdf</artifactId>
      <version>${openpdf.version}</version>
    </dependency>

    <!-- Tests : JUnit 5, Mockito, assertions Spring -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Tests : utilitaires de test Spring Kafka (consommateur embarqué, etc.) -->
    <dependency>
      <groupId>org.springframework.kafka</groupId>
      <artifactId>spring-kafka-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <!-- Pas de spring-boot-maven-plugin : il s'agit d'une librairie (jar classique),
       pas d'une application exécutable. -->

</project>
